        </introduction>

        <task workspace="0.25in">
            <statement>
                <p>
                    Construct a table to show the conditional probability distribution of antibiotic responses from Bacillus data. 
                </p>
            </statement>
        </task>

        <task workspace="0.25in">
            <statement>
                <p>
                    Construct a table to show the conditional probability distribution of bacteria species from susceptible responses. 
                </p>
            </statement>
        </task>

        <task workspace="1.5in">
            <statement>
                <p>
                    Construct a contingency table between bacteria species and culture medium.
                </p>
            </statement>
        </task>

        <task workspace="2.5in">
            <statement>
                <p>
                    Conduct a test for independence between bacteria species and culture medium with 95% significance.
                </p>
            </statement>
        </task>

        <task workspace="1.5in">
            <statement>
                <p>
                    Construct a contingency table between bacteria species and antibiotic response.
                </p>
            </statement>
        </task>

        <task workspace="2.5in">
            <statement>
                <p>
                    Conduct a test for independence between bacteria species and antibiotic response with 95% significance.
                </p>
            </statement>
        </task>

    </exercise>

</worksheet>
