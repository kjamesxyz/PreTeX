        <task>
            <statement>
                <p>
                    Sketch a scatterplot of the data below that shows dose along the horizontal axis and plasma concentration across the y axis. 
                </p>
                <image source="images/blankQ1axes.jpg" width="50%">
                    <shortdescription>A blank set of positive axes.</shortdescription>
                </image>
            </statement>
            
        </task>

        <task workspace="1.5in">
            <statement>
                <p>
                    Fit a regression line to the data and sketch it on the graph above. 
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Use the regression line you built in part (b) to find the predicted concentration at each dose. 
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Find the standard error in the slope. 
                </p>
            </statement>
        </task>

        <task workspace="2in">
            <statement>
                <p>
                    The drug designer claims that the plasma concentration increases with the dose administered. Test their claim with 95% confidence interval test. 
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Sketch your confidence interval onto your graph. Shade appropriately.
                </p>
            </statement>
        </task>
