<exercise>
        <introduction>
        <p>
            <alert>Prep Work:</alert> Record your answers to the following prompts in your prep work journal. Your answers (and optionally the prompts) should be the <alert> only </alert> material entered into your journal. Do <alert> not </alert> include supporting definitions, theorems, examples, or remarks of any kind. 
        </p>
        </introduction>

        <task>
            <statement>
                <p>
                    State the null and alternative hypotheses.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Choose an appropriate test statistic and method.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Conduct the experiment (calculate relevant quantities).
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Indicate whether the results of your test suggest we <alert>reject</alert> of <alert>fail to reject</alert> the null hypothesis.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Interpret your results in plain language.
                </p>
            </statement>
        </task>

    </exercise>
