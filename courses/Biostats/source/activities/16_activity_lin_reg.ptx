<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="biostats-act-16" xmlns:xi="http://www.w3.org/2001/XInclude">
    <title>🏫 Activity 16 - Linear Regression</title>

    <introduction>
        <p> This assignment is due at the beginning of class on <alert> Monday, November 16</alert>. It is graded based on completeness according to the rubric available on Canvas. You are encouraged to use your notes and collaborate with your group members to complete this activity. </p>
    </introduction>

    <exercise>
        <introduction>
        <p>
            <alert>Prep Work:</alert>  Record your answers to the following prompts in your prep work journal. Your answers should be the <alert> only </alert> material entered into your journal. Do <alert> not </alert> include supporting definitions, theorems, examples, or remarks of any kind. 
        </p>
        </introduction>

        <task>
            <statement>
                <p>
                    Write the formula for least-squares error between two variables <m>X</m> and <m>Y</m>.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Write the formula for the slope and <m>y</m>-intercept of the regression line.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Write the formula for the linear correlation coefficient between <m>X</m> and <m>Y</m>.
                </p>
            </statement>
        </task>
    </exercise>

    <exercise>
        <introduction>
            <p>
                Consider the bivariate data shown in the table below.
            </p>
            <tabular>
                <row header="yes">
                    <cell>X</cell>
                    <cell>Y</cell>
                </row>
                <row>
                    <cell>1</cell>
                    <cell>1</cell>
                </row>
                <row>
                    <cell>1</cell>
                    <cell>2</cell>
                </row>
                <row>
                    <cell>2</cell>
                    <cell>2</cell>
                </row>
                <row>
                    <cell>4</cell>
                    <cell>6</cell>
                </row>
            </tabular>
        </introduction>

        <task>
            <statement>
                <p>
                    Sketch a scatterplot for the data in the axes below. 
                </p>
                <image source="images/blankQ1axes.jpg" width="50%">
                    <shortdescription>A blank set of positive axes.</shortdescription>
                </image>
            </statement>
        </task>

        <task workspace="0.25in">
            <statement>
                <p>
                    Compute the least-squares error. 
                </p>
            </statement>
        </task>

        <task workspace="0.25in">
            <statement>
                <p>
                    Compute <m>S_{XX}</m>
                </p>
            </statement>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    Use your work from parts (a)-(c) to find the regression line.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Sketch the regression line onto the axes above. 
                </p>
            </statement>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    Compute the linear correlation coefficient between <m>X</m> and <m>Y</m>. 
                </p>
            </statement>
        </task>
    </exercise>

    <exercise>
        <introduction>
            <p>
                A clinical trial consists of 20 participants, who were randomly split into equal sized treatment and control groups. After 12 weeks of taking a medication, a particular biomarker was measured from a blood sample. The results of the test are shown in the table below. 
            </p>

            <sidebyside widths="48% 48%">
                <table>
                    <title>Treatment Group</title>
                    <tabular>
                        <row header="yes">
                            <cell>Patient ID</cell>
                            <cell>Baseline Biomarker</cell>
                            <cell>Week-12 Biomarker</cell>
                        </row>
                        <row>
