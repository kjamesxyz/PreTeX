                        <cell>68.2</cell>
                        <cell>65</cell>
                </row>
                <row>
                    <cell>Height of Son</cell>
                        <cell>73</cell>
                        <cell>68</cell>
                        <cell>68</cell>
                        <cell>71</cell>
