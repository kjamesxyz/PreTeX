    <exercise workspace="3in">
        <statement>
            <p>
                The table below shows the heights (in in.) of fathers and their eldest sons. Test the claim that sons are the same height as their fathers with 5% significance
            </p>
            <tabular>
                <row>
                    <cell>Height of Father</cell>
                        <cell>72</cell>
                        <cell>66</cell>
                        <cell>69</cell>
                        <cell>70</cell>
                        <cell>70</cell>
                        <cell>70</cell>
                        <cell>70</cell>
