    <exercise>
        <introduction>
            <p>
                The table below shows the amount of carbohydrates (in g) and the number of Calories in a single serving of 6 different foods.
            </p>

            <tabular>
                <row>
                    <cell>Carbs (in g)</cell>
                        <cell>8</cell>
                        <cell>9.5</cell>
                        <cell>10</cell>
                        <cell>6</cell>
                        <cell>7</cell>
                        <cell>4</cell>
                </row>
                <row>
                    <cell>Calories</cell>
                        <cell>120</cell>
                        <cell>138</cell>
                        <cell>147</cell>
                        <cell>88</cell>
                        <cell>108</cell>
                        <cell>62</cell>
                </row>
            </tabular>
        </introduction>

        <task workspace="0.25in">
            <statement>
                <p>
                    Compute the mean and standard deviation grams of carbs per serving.
                </p>
            </statement>
        </task>

        <task workspace="0.25in">
            <statement>
                <p>
                    Compute the mean and standard deviation number of Calories per serving.
                </p>
            </statement>
        </task>

        <task workspace="1in">
            <statement>
                <p>
                    Find the equation of the regression line between grams of carbs and number of Calories. 
                </p>
            </statement>
        </task>

        <task workspace="0.5in">
            <statement>
                <p>
                    Compute the linear correlation coefficient between grams of carbs and number of Calories.
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    Sketch a scatterplot and the regression line for the data on the axes below.
                </p>
                <image source="images/blankQ1axes.jpg" width="50%">
                    <shortdescription>A blank set of positive axes.</shortdescription>
                </image>
            </statement>
        </task>



    </exercise>
    


</worksheet>
