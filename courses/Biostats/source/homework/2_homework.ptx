            <statement>
                <p>
                    Mean bill depth
                </p>
            </statement>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Range of flipper lengths
                </p>
            </statement>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Standard deviation in body mass
                </p>
            </statement>
        </task>
        <task workspace="0.25in">
            <statement>
                <p>
                    Median bill length
                </p>
            </statement>
        </task>
        <task workspace="0.25in">
