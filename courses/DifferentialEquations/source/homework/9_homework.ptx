    <exercise workspace="5in">
        <statement>
            <p>
                Find and write the first four nonzero terms of a power series solution to the IVP <md> (x^2 + 1)y'' + 2xy' = 0; \ y(0)=y'(0)=1 </md>
            </p>
        </statement>
    </exercise>

    <exercise workspace="5in">
        <statement>
            <p>
                Find and write the first four nonzero terms of the general power series solution on <m>(0,\infty)</m> to the ODE <md> 2xy'' - (3 + 2x)y' + y = 0.</md>
            </p>
        </statement>
    </exercise>


</worksheet>
