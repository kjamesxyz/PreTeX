    <exercise workspace="1.5in">
        <statement>
            <p>
                Use the definition of the Laplace transform to compute <m>\laplace{f(t)}</m> where <md> f(t) = \begin{cases} 2t + 1 \amp 0 \leq t \lt 1; \\ 0 \amp t \geq 1. \end{cases} </md>
            </p>
        </statement>
    </exercise>

    <exercise workspace="1.5in">
        <statement>
            <p>
                Compute <m> \laplace{(1 - e^t + 3e^{-4t})\cos(5t)} </m>. 
            </p>
        </statement>
    </exercise>

    <exercise workspace="3in">
        <statement>
            <p>
                Use the convolution theorem to compute <m> \lapinv{\frac{1}{s^3 + 4s^2 + 5s}} </m>. 
            </p>
        </statement>
    </exercise>

    <exercise workspace="3in">
        <statement>
            <p>
                Use Laplace transforms to solve the IVP <md> y'' - 4y' + 4y = t^3 e^{2t}; \ y(0) = y'(0) = 0.</md> 
            </p>
        </statement>
    </exercise>

</worksheet>
