    <exercise workspace="1.5in">
        <statement>
            <p>
                Solve the IVP <md> z'' + z = 2e^{-t}; \ z(0) = z'(0) = 0 </md> using the method of undetermined coefficients by taking the <q>superposition</q> approach. 
            </p>
        </statement>
    </exercise>

    <exercise workspace="2in">
        <statement>
            <p>
                Solve <md> \ddot{x} - 3\dot{x} + 2x = e^t \sin(t) </md> using the method of undetermined coefficients by taking the <q>annihilator</q> approach. 
            </p>
        </statement>
    </exercise>

    <exercise workspace="4in">
        <statement>
            <p>
                Solve <md> \deriv{^2y}{x^2} - 6\deriv{y}{x} + 9y = x^{-3}e^{3x} </md> using variation of parameters. 
            </p>
        </statement>
    </exercise>
</worksheet>
