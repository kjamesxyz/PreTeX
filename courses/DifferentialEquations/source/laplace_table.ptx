<worksheet>
  <title>Common Laplace Transforms</title>
    <tabular halign="center">
      <row header="yes">
        <cell>Function <m>f(t)</m></cell>
        <cell>Laplace transform <m>\mathcal{L}\{f(t)\}=F(s)</m></cell>
      </row>
      <row>
        <cell><m>1</m></cell>
        <cell><m>\dfrac{1}{s}</m></cell>
      </row>
      <row>
        <cell><m>t^n \ (n=0,1,2,\ldots)</m></cell>
        <cell><m>\dfrac{n!}{s^{n+1}}</m></cell>
      </row>
      <row>
        <cell><m>e^{at}</m></cell>
        <cell><m>\dfrac{1}{s-a}</m></cell>
      </row>
      <row>
        <cell><m>\sin(bt)</m></cell>
        <cell><m>\dfrac{b}{s^2+b^2}</m></cell>
      </row>
      <row>
        <cell><m>\cos(bt)</m></cell>
        <cell><m>\dfrac{s}{s^2+b^2}</m></cell>
      </row>
      <row>
        <cell><m>\sinh(bt)</m></cell>
        <cell><m>\dfrac{b}{s^2-b^2}</m></cell>
      </row>
      <row>
        <cell><m>\cosh(bt)</m></cell>
        <cell><m>\dfrac{s}{s^2-b^2}</m></cell>
      </row>
      <row>
        <cell><m>\scr{H}_a(t) \ (a\geq 0)</m></cell>
        <cell><m>\dfrac{e^{-as}}{s}</m></cell>
      </row>
      <row>
        <cell><m>\delta(t - a)</m></cell>
        <cell><m>e^{-as}</m></cell>
      </row>

      <row>
        <cell><m>e^{at}f(t)</m></cell>
        <cell><m>F(s-a)</m></cell>
      </row>
      <row>
        <cell><m>f(t-a)\scr{H}_a(t)</m></cell>
        <cell><m>e^{-as}F(s)</m></cell>
      </row>
      <row>
        <cell><m>f * g</m></cell>
        <cell><m>F(s) G(s)</m></cell>
      </row>
    </tabular>
</worksheet>
