<worksheet>
  <title>Common Laplace Transforms</title>
    <tabular halign="center">
      <row header="yes">
        <cell>Function <m>f(t)</m></cell>
        <cell>Laplace transform <m>\mathcal{L}\{f(t)\}=F(s)</m></cell>
      </row>
      <row>
        <cell><m>1</m></cell>
        <cell><m>\dfrac{1}{s}</m></cell>
      </row>
      <row>
        <cell><m>t^n \ (n=0,1,2,\ldots)</m></cell>
        <cell><m>\dfrac{n!}{s^{n+1}}</m></cell>
      </row>
      <row>
        <cell><m>e^{at}</m></cell>
        <cell><m>\dfrac{1}{s-a}</m></cell>
      </row>
      <row>
        <cell><m>\sin(bt)</m></cell>
        <cell><m>\dfrac{b}{s^2+b^2}</m></cell>
      </row>
      <row>
        <cell><m>\cos(bt)</m></cell>
        <cell><m>\dfrac{s}{s^2+b^2}</m></cell>
      </row>
      <row>
        <cell><m>\sinh(bt)</m></cell>
        <cell><m>\dfrac{b}{s^2-b^2}</m></cell>
      </row>
      <row>
        <cell><m>\cosh(bt)</m></cell>
        <cell><m>\dfrac{s}{s^2-b^2}</m></cell>
      </row>
      <row>
        <cell><m>\scr{H}_a(t) = \begin{cases} 1 \amp x \geq a \\ 0 \amp x \lt a \end{cases} \ (a\geq 0)</m></cell>
        <cell><m>\dfrac{e^{-as}}{s}</m></cell>
      </row>
      <row>
        <cell><m>\delta(t - a) = \begin{cases} \infty \amp x = a \\ 0 \amp x \neq a \end{cases}</m></cell>
        <cell><m>e^{-as}</m></cell>
      </row>

      <row>
        <cell><m>e^{at}f(t)</m></cell>
        <cell><m>F(s-a)</m></cell>
      </row>
      <row>
        <cell><m>f(t-a)\scr{H}_a(t)</m></cell>
        <cell><m>e^{-as}F(s)</m></cell>
      </row>
      <row>
        <cell><m>f(t) * g(t)</m></cell>
        <cell><m>F(s) G(s)</m></cell>
      </row>
      <row>
        <cell><m>t^n f(t)</m></cell>
        <cell><m>(-1)^n \frac{d^n}{ds^n} F(s)</m></cell>
      </row>
      <row>
        <cell><m>f^{(n)}(t)</m></cell>
        <cell><m>s^n F(s) - s^{n-1}f(0) - s^{n-2}f'(0) - \cdots sf^{(n-2)}(0) - f^{(n-1)}(0)</m></cell>
      </row>
    </tabular>
</worksheet>
