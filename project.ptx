<?xml version="1.0" encoding="utf-8"?>

<project ptx-version="2" source="./" publication="./">
    <targets>
        <target name="biostats-html" 
                format="html"
                source="./courses/Biostats/source/main_course.ptx"
                publication="./courses/Biostats/publication/publication.ptx"
                deploy-dir="output/Biostats/web"/>
        
        <target name="biostats-notes" 
                format="html"
                source="./courses/Biostats/source/main_notes.ptx"
                publication="./courses/Biostats/publication/publication_notes.ptx"
                deploy-dir="output/Biostats/web"/>

        <target name="diffeq-html" 
                format="html"
                source="./courses/DifferentialEquations/source/main.ptx"
                publication="./courses/DifferentialEquations/publication/publication.ptx"
                deploy-dir="output/DifferentialEquations/web"/>
    </targets>
</project>
