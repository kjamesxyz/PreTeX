<?xml version="1.0" encoding="utf-8"?>

<project ptx-version="2" source="./" publication="./">
    <targets>
        <target name="biostats-html" 
                format="html"
                source="./courses/Biostats/source/main_course.ptx"
                publication="./courses/Biostats/publication/publication.ptx"
                deploy-dir="output/Biostats/web_course"/>
        
        <target name="biostats-notes" 
                format="html"
                source="./courses/Biostats/source/main_notes.ptx"
                publication="./courses/Biostats/publication/publication_notes.ptx"
                deploy-dir="output/Biostats/web_notes"/>

        <target name="biostats-exams" 
                format="html"
                source="./courses/Biostats/source/main_exams.ptx"
                publication="./courses/Biostats/publication/publication_exams.ptx"/>

        <target name="diffeq-html" 
                format="html"
                source="./courses/DifferentialEquations/source/main_html.ptx"
                publication="./courses/DifferentialEquations/publication/publication.ptx"
                deploy-dir="output/DifferentialEquations/web_course"/>

        <target name="diffeq-notes" 
                format="html"
                source="./courses/DifferentialEquations/source/main_notes.ptx"
                publication="./courses/DifferentialEquations/publication/publication_notes.ptx"
                deploy-dir="output/DifferentialEquations/web_notes"/>

        <target name="diffeq-exams" 
                format="html"
                source="./courses/DifferentialEquations/source/main_exams.ptx"
                publication="./courses/DifferentialEquations/publication/publication_exams.ptx"/>
    </targets>
</project>
